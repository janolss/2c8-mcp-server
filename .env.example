# Base URL of your 2c8 MT backend (no trailing slash required)
TWO_C8_BASE_URL=https://your-server.example/mt-backend

# API key sent as x-api-key
TWO_C8_API_KEY=replace-me

# When false (default), only read/analysis tools are registered.
# Set to true to also register create/update/delete tools.
TWO_C8_ALLOW_WRITES=false

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio

# HTTP listen settings (used when MCP_TRANSPORT=http or --http)
PORT=3000
HOST=127.0.0.1
